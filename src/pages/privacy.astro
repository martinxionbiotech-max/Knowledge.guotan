---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site-config';
import { SITES } from '../lib/sites';
import { breadcrumbJsonLd } from '../lib/seo';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Privacy & Editorial Policy', path: '/privacy/' },
];
const jsonLd = [
  breadcrumbJsonLd(crumbs.map((c) => ({ name: c.name, url: new URL(c.path, Astro.site).href }))),
];
---

<BaseLayout
  site={site}
  title="Privacy & Editorial Policy"
  description="Charcoal Hub Knowledge sub-site policy: editorial standards, sourcing and uncertainty labelling for buyer guides, and what this site does not collect."
  canonical={canonical}
  jsonLd={jsonLd}
  breadcrumbs={crumbs.map((c) => ({ name: c.name, url: c.path }))}
>
  <div class="page-title container">
    <h1>Privacy &amp; Editorial Policy</h1>
    <p class="lede">
      This sub-site publishes buyer education: guides on choosing, comparing,
      sourcing and shipping charcoal. This page explains how articles are
      sourced and what they do not claim.
    </p>
  </div>

  <section class="section">
    <div class="container prose">
      <p>Last updated: 2026-10-07</p>

      <h2>1. Editorial standards</h2>
      <p>
        Every article carries a data source, a verification status, an
        uncertainty note and a last-verified date. Figures are class-level
        references from public sources — reported ranges that vary by product,
        batch and conditions — not promises about any supplier's goods.
      </p>

      <h2>2. What guides never claim</h2>
      <p>
        No fabricated suppliers, no invented test results, no unsupported
        certifications. Regulatory content (import rules, EUDR notes, shipping
        classifications) is orientation only — confirm current requirements
        with your customs broker, forwarder or a qualified advisor.
      </p>

      <h2>3. What we do not collect</h2>
      <p>
        No analytics, no tracking cookies, no advertising pixels. The hosting
        platform may keep standard security logs under its own policy.
      </p>

      <h2>4. Inquiries</h2>
      <p>
        This sub-site has no forms. Network-wide terms: main site
        <a href={`${SITES.main}/privacy/`}>privacy policy</a> and
        <a href={`${SITES.main}/terms/`}>terms of use</a>. Contact:
        <a href="mailto:sales@guotan.com">sales@guotan.com</a>.
      </p>
    </div>
  </section>
</BaseLayout>
